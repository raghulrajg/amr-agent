# Broker settings for the Task Scheduler link (python amr_agent.py scheduler).
# Copy this file to .env in this folder and fill it in -- or use the Task
# Scheduler's own .env with --env-file; the variable names are the same.
# .env is in .gitignore: never commit it.

MQTT_BROKER_HOST=172.25.200.57
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# 1 for EMQX's SSL listener (usually port 8883), with the CA certificate:
MQTT_TLS=0
# MQTT_TLS_CA_CERT=C:\robot-fleet\ca.crt

# Rarely changed (defaults shown)
# RUN_MODE=real               # "test" = the scheduler's TEST mode, same as --test
# MQTT_TOPIC_PREFIX=          # real mode: topics at the root (test mode uses "sim/")
# LOG_LEVEL=INFO
